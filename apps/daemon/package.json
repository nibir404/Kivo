{
  "name": "@kivo/daemon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kivo's local daemon: projects, files, git, terminals, builds and the AI agent, on 127.0.0.1.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts --serve",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kivo/core": "*",
    "node-pty": "^1.1.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
