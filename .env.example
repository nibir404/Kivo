# ── AI providers (any subset). Keys stay in the daemon; the browser never sees them. ──

# Groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Puku (puku.sh)
PUKU_API_KEY=
# PUKU_BASE_URL=https://api.puku.sh/v1
# PUKU_MODELS=puku-default,puku-fast
# PUKU_AUTH_HEADER=authorization      # or e.g. x-api-key, once Puku confirms the header
# PUKU_JSON_MODE=0

# Any other OpenAI-compatible endpoint
# OPENAI_COMPAT_LABEL=OpenRouter
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODELS=anthropic/claude-sonnet-5

# Which provider to prefer, and whether others may take over when it's rate-limited
# KIVO_PROVIDER=groq
# KIVO_CROSS_PROVIDER_FAILOVER=1

# ── Kivo ──
# KIVO_DAEMON_PORT=5175          # daemon (and the UI, with `npm start`)
# KIVO_UI_PORT=5174              # Vite dev server (`npm run dev`)
# KIVO_UI_ORIGINS=               # extra origins allowed to call the daemon, comma-separated
# KIVO_HOME=~/.kivo              # where projects live (default: .kivo-workspace in this folder)
# KIVO_PROJECT=tandem
# KIVO_BASE=/                   # URL path the built UI is served from (e.g. /app/ for a hosted copy)
# KIVO_EXTRA_PACKAGES=           # PyPI packages you trust builds to install, e.g. pyotp,qrcode==7.4
