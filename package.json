{
  "name": "kivo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n daemon,ui -c gray,blue \"npm:dev:daemon\" \"npm:dev:ui\"",
    "dev:daemon": "npm run dev -w @kivo/daemon",
    "dev:ui": "npm run dev -w @kivo/web",
    "build": "npm run build -w @kivo/web",
    "start": "npm start -w @kivo/daemon",
    "prod": "npm run build && npm start",
    "preview": "npm run preview -w @kivo/web",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
